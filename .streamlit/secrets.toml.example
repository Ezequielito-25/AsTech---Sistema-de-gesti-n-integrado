# Copiá este archivo como secrets.toml (en la misma carpeta .streamlit) y completá los datos
# con la salida de:  python generar_hash.py
# Nunca subas secrets.toml a GitHub. En Streamlit Community Cloud se carga en "Secrets".

[auth]
usuario = "tu_usuario"
salt = "reemplazar_con_salida_de_generar_hash"
password_hash = "reemplazar_con_salida_de_generar_hash"

[db]
# Cadena de conexión de Supabase (Connect → Session pooler). Reemplazá [TU-CONTRASEÑA].
url = "postgresql://postgres.fwbvhtmwkbyffjpwzctl:[TU-CONTRASEÑA]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"
